# ArchCanvas 环境变量配置模板
# 使用方式：复制为 configs/.env 并填入真实密钥（文件权限建议保持 0600）

# 大模型供应商 API Key（按需配置）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 可选访问令牌：当以 -host 0.0.0.0 对局域网/公网暴露时强烈建议启用
# 启用后客户端需通过 Authorization: Bearer <token> 或 X-ArchCanvas-Token 头访问 /api/v1/*
ARCHCANVAS_AUTH_TOKEN=

# 可选跨域白名单（逗号分隔具体 Origin，如 http://localhost:5173,https://arch.example.com）
CORS_ALLOWED_ORIGINS=

# 如需允许连接局域网内网私有部署大模型（如 http://192.168.1.50:11434/v1），设为 1
ARCHCANVAS_ALLOW_PRIVATE_LLM=0

# 公开简历演示沙盒模式（公网免登录暴露推荐开启：SHOWCASE_MODE=true）
# 开启后：1) 自动内置 2 个只读官方样板工程；2) 访客草稿按 Cookie/X-Visitor-ID 隔离且 24h 自动清扫；
# 3) 锁死 models/save 与 models/probe 防篡改配置与 SSRF；4) 按 Cloudflare 真实访客 IP 限额每日 20 次、全站每日 100 次。
SHOWCASE_MODE=false
SHOWCASE_IP_DAILY_LIMIT=20
SHOWCASE_GLOBAL_DAILY_LIMIT=100
SHOWCASE_VISITOR_TTL_HOURS=24
SHOWCASE_MAX_PROJECTS_PER_VISITOR=10
