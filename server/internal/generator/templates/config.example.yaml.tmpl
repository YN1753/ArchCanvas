server:
  port: "{{ .Port }}"
  mode: "debug" # debug | release

database:
  driver: "{{ .DBDriver }}" # mysql | postgres | sqlite
  dsn: "{{ .DefaultDSN }}"
  max_open_conns: 100
  max_idle_conns: 10
  conn_max_lifetime: "1h"

{{- if .EnableRedis }}
redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0
  pool_size: 50
{{- end }}

log:
  level: "info"
