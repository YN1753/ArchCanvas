FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/server cmd/server/main.go

FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/server /app/server
COPY configs/ /app/configs/

EXPOSE {{ .Port }}
CMD ["/app/server"]
