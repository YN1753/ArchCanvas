func (r *{{ .Entity.VarName }}Repository) List(ctx context.Context, offset, limit int) ([]*model.{{ .Entity.StructName }}, int64, error) {
	var items []*model.{{ .Entity.StructName }}
	var total int64
	db := r.db.WithContext(ctx).Model(&model.{{ .Entity.StructName }}{})
	if err := db.Count(&total).Error; err != nil {
		return nil, 0, err
	}
	if limit > 0 {
		db = db.Offset(offset).Limit(limit)
	}
	if err := db.Find(&items).Error; err != nil {
		return nil, 0, err
	}
	return items, total, nil
}

func (r *{{ .Entity.VarName }}Repository) Update(ctx context.Context, item *model.{{ .Entity.StructName }}) error {
	res := r.db.WithContext(ctx).
		Model(&model.{{ .Entity.StructName }}{}).
		Where(clause.Eq{Column: clause.Column{Name: {{ printf "%q" .Entity.PrimaryKey.Name }}}, Value: item.{{ .Entity.PrimaryKey.FieldName }}}).
		Omit("created_at").
		Updates(item)
	if res.Error != nil {
		return res.Error
	}
	if res.RowsAffected == 0 {
		return gorm.ErrRecordNotFound
	}
	return nil
}

