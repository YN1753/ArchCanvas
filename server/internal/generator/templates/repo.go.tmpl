func (r *{{ .Entity.VarName }}Repository) GetByID(ctx context.Context, id {{ .Entity.PrimaryKey.GoType }}) (*model.{{ .Entity.StructName }}, error) {
	var item model.{{ .Entity.StructName }}
	err := r.db.WithContext(ctx).
		Where(clause.Eq{Column: clause.Column{Name: {{ printf "%q" .Entity.PrimaryKey.Name }}}, Value: id}).
		First(&item).Error
	if err != nil {
