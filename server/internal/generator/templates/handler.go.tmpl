	if err := c.ShouldBindJSON(&item); err != nil {
		response.Fail(c, 400, "参数格式错误: "+err.Error())
		return
	}
	{{- if .Entity.PrimaryKey.FieldName }}
	if c.Param("id") != "" {
		id, ok := h.parse{{ .Entity.StructName }}ID(c)
		if !ok {
			return
		}
		item.{{ .Entity.PrimaryKey.FieldName }} = id
	}
	{{- end }}
	if err := h.svc.Update(c.Request.Context(), &item); err != nil {
