func (h *{{ .Entity.StructName }}Handler) parse{{ .Entity.StructName }}ID(c *gin.Context) ({{ .Entity.PrimaryKey.GoType }}, bool) {
	idStr := c.Param("id")
	{{- if or (eq .Entity.PrimaryKey.GoType "uint64") (eq .Entity.PrimaryKey.GoType "uint") (eq .Entity.PrimaryKey.GoType "uint32") (eq .Entity.PrimaryKey.GoType "uint16") (eq .Entity.PrimaryKey.GoType "uint8") }}
	id, err := strconv.ParseUint(idStr, 10, 64)
	if err != nil {
		response.Fail(c, 400, "无效的 ID 参数")
		return 0, false
	}
	return {{ .Entity.PrimaryKey.GoType }}(id), true
	{{- else if or (eq .Entity.PrimaryKey.GoType "int64") (eq .Entity.PrimaryKey.GoType "int") (eq .Entity.PrimaryKey.GoType "int32") (eq .Entity.PrimaryKey.GoType "int16") (eq .Entity.PrimaryKey.GoType "int8") }}
	id, err := strconv.ParseInt(idStr, 10, 64)
	if err != nil {
		response.Fail(c, 400, "无效的 ID 参数")
		return 0, false
	}
	return {{ .Entity.PrimaryKey.GoType }}(id), true
	{{- else }}
	return idStr, true
	{{- end }}
}

func (h *{{ .Entity.StructName }}Handler) Create(c *gin.Context) {
	var item model.{{ .Entity.StructName }}
	if err := c.ShouldBindJSON(&item); err != nil {
		response.Fail(c, 400, "参数格式错误: "+err.Error())
		return
	}
	if err := h.svc.Create(c.Request.Context(), &item); err != nil {
		response.Fail(c, 500, "创建失败: "+err.Error())
		return
	}
	response.Success(c, item)
}

func (h *{{ .Entity.StructName }}Handler) GetDetail(c *gin.Context) {
	id, ok := h.parse{{ .Entity.StructName }}ID(c)
	if !ok {
		return
	}
	item, err := h.svc.GetDetail(c.Request.Context(), id)
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			response.Fail(c, 404, "记录不存在")
			return
		}
		response.Fail(c, 500, "查询详情失败: "+err.Error())
		return
	}
	response.Success(c, item)
}

